# Environment
CAREEROS_ENVIRONMENT=local
CAREEROS_DEBUG=true
CAREEROS_LOG_LEVEL=DEBUG

# Database
CAREEROS_DATABASE_URL=postgresql+asyncpg://careeros:careeros@localhost:5432/careeros
CAREEROS_DATABASE_ECHO=false

# Redis
CAREEROS_REDIS_URL=redis://localhost:6379/0

# Auth (CHANGE IN PRODUCTION)
CAREEROS_JWT_SECRET_KEY=local-dev-secret-change-me-in-production
CAREEROS_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Google Cloud (empty = use emulators / local mode)
CAREEROS_GCP_PROJECT_ID=
CAREEROS_GCS_BUCKET_NAME=careeros-uploads-local
CAREEROS_PUBSUB_TOPIC_PREFIX=careeros

# GitHub App (fill when setting up GitHub integration)
CAREEROS_GITHUB_APP_ID=
CAREEROS_GITHUB_CLIENT_ID=
CAREEROS_GITHUB_CLIENT_SECRET=
CAREEROS_GITHUB_WEBHOOK_SECRET=

# Vertex AI
CAREEROS_VERTEX_AI_LOCATION=us-central1
CAREEROS_VERTEX_AI_MODEL=gemini-2.0-flash

# Pub/Sub emulator (for local development)
PUBSUB_EMULATOR_HOST=localhost:8085
